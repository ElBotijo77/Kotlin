<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.DonaVida" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Pantalla de carga (SplashScreen API, también en Android 7 con core-splashscreen).
         Solo se ve mientras arranca la app; después se aplica Theme.DonaVida. -->
    <style name="Theme.DonaVida.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.DonaVida</item>
    </style>
</resources>
